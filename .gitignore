# Виртуальное окружение (на компьютере у каждого оно своё)
venv/
.venv/
env/

# Служебные файлы Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Локальная база данных (у тебя там пароли, у других её не должно быть)
db.sqlite3

# Секретные файлы (если будешь использовать .env для паролей)
.env

# Папка с загруженными картинками тортов (чтобы не забивать Гитхаб)
media/

# Настройки VS Code (у каждого разработчика они свои)
.vscode/